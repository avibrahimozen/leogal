{
  "expo": {
    "name": "Ulak",
    "slug": "ulak",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ulak",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ulak.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ulak, size en yakın taksiyi bulmak ve yolculuğunuzu takip etmek için konumunuzu kullanır."
      }
    },
    "android": {
      "package": "com.ulak.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ulak, size en yakın taksiyi bulmak ve yolculuğunuzu takip etmek için konumunuzu kullanır."
        }
      ]
    ]
  }
}
