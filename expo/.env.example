# Copy to `.env` (gitignored) and fill in. Restart `expo start` after changes.
#
# SECURITY: keys in the app are extractable — fine for personal/Expo Go dev only.

# --- Brain (required) ---
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# Optional override (e.g. your proxy). Defaults to https://api.anthropic.com
EXPO_PUBLIC_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Voice: talk to Samantha + her warm, laughing voice (required for voice) ---
# One ElevenLabs key covers both speech-to-text (Scribe) and expressive
# text-to-speech (v3, which renders [laughs]/[giggles] as real human sounds).
# Get one at https://elevenlabs.io  → Profile → API key.
EXPO_PUBLIC_ELEVENLABS_API_KEY=
# Optional: pick a warm, multilingual voice id (defaults to a built-in one).
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional: TTS model. eleven_v3 supports laughter/audio tags.
EXPO_PUBLIC_ELEVENLABS_MODEL=eleven_v3
