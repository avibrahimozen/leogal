// Copy this file to `Secrets.xcconfig` (which is gitignored) and fill in values.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// SECURITY: Shipping a raw Anthropic API key inside an app is insecure — anyone
// can extract it from the binary. This direct-key path is for personal/dev builds
// only. For anything you distribute, point ANTHROPIC_BASE_URL at your own backend
// proxy that holds the key server-side and leave ANTHROPIC_API_KEY empty.

// Your Anthropic API key (dev builds only). Leave empty when using a proxy.
ANTHROPIC_API_KEY =

// Base URL for the Messages API. Default is Anthropic direct.
// For a proxy:  https:/$()/your-proxy.example.com
// (the $() escapes the // so xcconfig doesn't treat it as a comment)
ANTHROPIC_BASE_URL = https:/$()/api.anthropic.com

// Optional: ElevenLabs key for the natural cloud voice (CloudVoice).
// Leave empty to use the on-device system voice.
ELEVENLABS_API_KEY =
ELEVENLABS_VOICE_ID =
